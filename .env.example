# Database: PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hookpulse
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/hookpulse

# Logging
LOG_LEVEL=INFO

# Security: HMAC secret key
WEBHOOK_SECRET=replace_with_a_long_random_secret

# Async worker and downstream delivery forwarding
ENABLE_ASYNC_WORKER=true
WEBHOOK_FORWARD_URL=
WORKER_MAX_RETRIES=3
WORKER_BACKOFF_FACTOR=2.0
WORKER_POLL_INTERVAL=1.0

# Rate limiting
RATE_LIMIT_RPS=100

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_unique_password